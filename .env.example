# ------------------------------------------------------------
#  BoostRize – משתני סביבה (העתיקו ל-.env לפיתוח מקומי)
#  ב-GitHub: Settings → Secrets and variables → Actions → Variables
#  כל ה-PUBLIC_* נחשפים בדפדפן – אסור לשים בהם סודות.
#  סודות (מפתחות API / Webhooks) נשמרים רק ב-Cloudflare Worker (wrangler secret put).
# ------------------------------------------------------------

# כתובת האתר ונתיב הבסיס. ברירת מחדל: GitHub Pages של המאגר
# לדומיין אישי:  SITE_URL=https://www.example.co.il   BASE_PATH=/
SITE_URL=
BASE_PATH=

# כתובת ה-Worker שמקבל לידים (ציבורית, לא סוד). ריק = הטופס במצב "בקרוב"
PUBLIC_LEAD_ENDPOINT=

# Cloudflare Turnstile – site key ציבורי (אופציונלי)
PUBLIC_TURNSTILE_SITE_KEY=

# מדידה – נטען רק אחרי הסכמת המשתמש
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_CLARITY_ID=
PUBLIC_GSC_VERIFICATION=

# וריאנט טופס ל-A/B
PUBLIC_FORM_VARIANT=multistep-v1

# ---------- Worker secrets (לא כאן! רק: npx wrangler secret put NAME) ----------
# WEBHOOK_URLS, WEBHOOK_SECRET, SHEETS_WEBHOOK_URL, MONDAY_API_TOKEN, MONDAY_BOARD_ID,
# MONDAY_COLUMN_MAP, HUBSPOT_TOKEN, RESEND_API_KEY, NOTIFY_EMAIL_TO, NOTIFY_EMAIL_FROM,
# WHATSAPP_TOKEN, WHATSAPP_PHONE_ID, WHATSAPP_NOTIFY_TO, TURNSTILE_SECRET
