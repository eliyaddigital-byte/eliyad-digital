---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import HomeSections from '../components/HomeSections.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { site } from '../config/site';
import { faqSection, services } from '../content/home';

const siteUrl = `${(Astro.site?.toString() || '').replace(/\/$/, '')}${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSection.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `השירותים של ${site.brand.name}`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.value,
      provider: { '@id': `${siteUrl}#organization` },
      areaServed: { '@type': 'Country', name: 'Israel' },
    },
  })),
};
---
<Base
  title={`${site.brand.name} | סוכנות פרסום ממומן, מדידה ואוטומציה`}
  description="סוכנות שיווק דיגיטלי לניהול קמפיינים בגוגל, פייסבוק, אינסטגרם וטיקטוק, עם מדידה מקצה לקצה, דוחות שקופים ואוטומציות. מתאמים שיחת אסטרטגיה."
  schema={[faqSchema, servicesSchema]}
>
  <Header slot="header" />
  <HomeSections />
  <Footer slot="footer" />
  <MobileCta slot="footer" />
</Base>
