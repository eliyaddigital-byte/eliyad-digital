---
/** תבנית לעמודי משנה (משפטיים, תודה, 404) */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/text';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  eyebrow?: string;
  heading: string;
  draft?: boolean;
  updated?: string;
  breadcrumbs?: boolean;
}
const { title, description, path, noindex, eyebrow, heading, draft, updated, breadcrumbs = true } = Astro.props;
const crumbs = breadcrumbs ? [{ name: 'ראשי', path: '/' }, { name: heading, path }] : undefined;
---
<Base title={title} description={description} path={path} noindex={noindex} breadcrumbs={crumbs}>
  <Header slot="header" home={false} />
  <article class="page">
    <div class="container page__wrap">
      {crumbs && (
        <nav aria-label="פירורי לחם" class="crumbs">
          <ol role="list"><li><a href={withBase('/')}>ראשי</a></li><li aria-current="page">{heading}</li></ol>
        </nav>
      )}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {updated && <p class="page__updated">עודכן לאחרונה: {updated}</p>}
      {draft && (
        <p class="page__draft" role="note">
          <strong>טיוטה:</strong> מסמך זה הוא טיוטה ראשונית שנכתבה כבסיס לעבודה ואינו מהווה ייעוץ משפטי. יש להעביר אותו לבדיקת עורך דין לפני הסתמכות עליו בפעילות מסחרית.
        </p>
      )}
      <div class="prose"><slot /></div>
    </div>
  </article>
  <Footer slot="footer" home={false} />
</Base>

<style>
  .page { padding-block: clamp(2.5rem, 5vw, 5rem) var(--section-y); }
  .page__wrap { max-width: 820px; }
  .crumbs ol { display: flex; gap: 0.5rem; font-size: var(--fs-sm); color: var(--ink-soft); margin-bottom: 2rem; }
  .crumbs li + li::before { content: '/'; margin-inline-end: 0.5rem; color: var(--line); }
  .crumbs a { color: var(--ink); }
  .page h1 { font-size: var(--fs-h2); margin-bottom: 1rem; }
  .page__updated { color: var(--ink-soft); font-size: var(--fs-sm); }
  .page__draft { margin-top: 1.5rem; padding: 1rem 1.25rem; border: 2px dashed var(--orange-600); background: var(--orange-50); border-radius: var(--radius); font-size: var(--fs-sm); }
  .prose { margin-top: 2.5rem; display: grid; gap: 1rem; }
  .prose :global(h2) { font-size: var(--fs-h3); margin-top: 1.5rem; }
  .prose :global(ul) { padding-inline-start: 1.25rem; display: grid; gap: 0.4rem; }
  .prose :global(li::marker) { color: var(--orange-600); }
  .prose :global(a) { color: var(--orange-ink); font-weight: 600; }
  .prose :global(.todo) { background: var(--orange-100); padding: 0 0.3em; border-radius: 3px; font-weight: 600; }
</style>
