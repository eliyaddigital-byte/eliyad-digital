---
import Icon from './Icon.astro';
import { faqSection } from '../content/home';
import { whatsappUrl, telUrl, site } from '../config/site';
---
<section class="band band--fog faq" id="faq" aria-labelledby="faq-title" data-section="faq">
  <div class="wrap faq__layout">
    <div class="faq__intro">
      <h2 id="faq-title" class="h-section">{faqSection.title}</h2>
      <p class="lede">לא מצאת תשובה? שאלו אותנו ישירות.</p>
      <div class="faq__direct">
        {whatsappUrl && <a class="btn btn--black" href={whatsappUrl} target="_blank" rel="noopener" data-cta-location="faq"><Icon name="whatsapp" size={18} />וואטסאפ</a>}
        {telUrl && <a class="btn btn--outline" href={telUrl} data-cta-location="faq"><Icon name="phone" size={18} /><span dir="ltr">{site.contact.phone}</span></a>}
      </div>
    </div>
    <div class="faq__list">
      {faqSection.items.map((f) => (
        <details class="qa" name="faq">
          <summary><span class="qa__q">{f.q}</span><span class="qa__plus" aria-hidden="true"></span></summary>
          <div class="qa__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.qa').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) window.__brTrack?.('faq_open', { faq_question: d.querySelector('.qa__q')?.textContent?.trim().slice(0, 80) });
    });
  });
</script>

<style>
  .faq__layout { display: grid; gap: 3rem; }
  .faq__intro { display: grid; gap: 1.25rem; align-content: start; justify-items: start; }
  .faq__direct { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }
  .faq__list { border-top: 3px solid var(--black); }
  .qa { border-bottom: 1px solid #c9ced4; }
  .qa summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 1.35rem 0; cursor: pointer; font-weight: 600; font-size: var(--t-md); }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary:hover .qa__q { color: var(--ember); }
  .qa__plus { position: relative; flex: none; width: 34px; height: 34px; border-radius: 50%; background: var(--white); }
  .qa__plus::before, .qa__plus::after { content: ''; position: absolute; inset: 16px 10px auto; height: 2px; background: var(--black); transition: transform 220ms var(--ease); }
  .qa__plus::after { transform: rotate(90deg); }
  .qa[open] .qa__plus { background: var(--orange); }
  .qa[open] .qa__plus::after { transform: rotate(0deg); }
  .qa__a { padding: 0 0 1.5rem; color: var(--slate); max-width: 62ch; }
  .qa[open] .qa__a { animation: qaOpen 260ms var(--ease); }
  @keyframes qaOpen { from { opacity: 0; transform: translateY(-4px); } }
  @media (min-width: 1024px) {
    .faq__layout { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; }
    .faq__intro { position: sticky; top: calc(var(--header-h) + 3rem); }
  }
</style>
