---
/**
 * Logo – BoostRize, קובץ הלוגו המקורי (public/brand/boostrize-logo.png).
 * variant="dark"  → הלוגו כמו שהוא (לרקע לבן/בהיר)
 * variant="light" → טקסט לבן + R כתום (לרקע שחור)
 * לא להציב על רקע כתום – ה-R הכתום נעלם.
 */
import { withBase } from '../lib/text';
interface Props { variant?: 'dark' | 'light'; class?: string; size?: 'sm' | 'md' | 'lg' }
const { variant = 'dark', class: cls = '', size = 'md' } = Astro.props;
const src = withBase(variant === 'light' ? 'brand/boostrize-logo-light.png' : 'brand/boostrize-logo.png');
---
<img class:list={['logo', `logo--${size}`, cls]} src={src} alt="BoostRize" width="396" height="74" decoding="async" translate="no" />

<style>
  .logo { display: block; width: auto; max-width: none; }
  .logo--sm { height: 28px; }
  .logo--md { height: 34px; }
  .logo--lg { height: 48px; }
</style>
