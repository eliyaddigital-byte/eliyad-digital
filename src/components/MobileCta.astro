---
/** Sticky CTA במובייל – מוביל לשאלון; אייקון וואטסאפ לפנייה ישירה. נעלם כשהשאלון על המסך */
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
---
<div class="mcta" data-mobile-cta aria-hidden="true">
  <a class="btn btn--black mcta__main" href="#contact" data-cta="mobile-sticky-quiz" tabindex="-1">בדיקה בדקה: איפה השיווק נתקע?</a>
  {whatsappUrl && (
    <a class="mcta__icon" href={whatsappUrl} target="_blank" rel="noopener" aria-label="וואטסאפ" data-cta-location="mobile-sticky" tabindex="-1"><Icon name="whatsapp" size={24} /></a>
  )}
</div>

<style>
  .mcta {
    position: fixed; z-index: 70; inset-inline: 0; bottom: 0; display: flex; gap: 0.5rem;
    padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--orange); transform: translateY(110%); transition: transform 280ms var(--ease);
  }
  .mcta:global(.is-visible) { transform: none; }
  .mcta__main { flex: 1; min-height: 52px; font-size: var(--t-base); }
  .mcta__icon { width: 52px; height: 52px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--white); color: var(--black); }
  @media (min-width: 900px) { .mcta { display: none; } }
</style>
