---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, whatsappUrl, telUrl, mailUrl } from '../config/site';
import { withBase } from '../lib/text';

interface Props { home?: boolean }
const { home = true } = Astro.props;
const h = (id: string) => (home ? `#${id}` : `${withBase('/')}#${id}`);
const nav = [
  { label: 'שירותים', href: h('services') },
  { label: 'איך עובדים', href: h('process') },
  { label: 'למי זה מתאים', href: h('fit') },
  { label: 'אודות', href: h('about') },
  { label: 'שאלות נפוצות', href: h('faq') },
  { label: 'יצירת קשר', href: h('contact') },
];
const legal = [
  { label: 'מדיניות פרטיות', href: withBase('/privacy/') },
  { label: 'תנאי שימוש', href: withBase('/terms/') },
  { label: 'הצהרת נגישות', href: withBase('/accessibility/') },
];
const socials = (Object.entries(site.social) as [string, string][]).filter(([, url]) => Boolean(url));
const socialLabel: Record<string, string> = { facebook: 'פייסבוק', instagram: 'אינסטגרם', linkedin: 'לינקדאין', tiktok: 'טיקטוק', youtube: 'יוטיוב' };
const consentEnabled = Boolean(site.analytics.gtmId || site.analytics.ga4Id || site.analytics.clarityId);
const year = new Date().getFullYear();
---
<footer class="ftr" data-section="footer">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <a href={home ? '#top' : withBase('/')} class="ftr__logo"><Logo variant="light" size="md" /></a>
        <p>{site.brand.tagline}</p>
      </div>
      <nav aria-label="ניווט בתחתית העמוד">
        <h2 class="ftr__h">ניווט</h2>
        <ul role="list">{nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      {(whatsappUrl || telUrl || mailUrl) && (
        <div>
          <h2 class="ftr__h">יצירת קשר</h2>
          <ul role="list">
            {whatsappUrl && <li><a href={whatsappUrl} target="_blank" rel="noopener" data-cta-location="footer"><Icon name="whatsapp" size={18} />וואטסאפ</a></li>}
            {telUrl && <li><a href={telUrl} data-cta-location="footer"><Icon name="phone" size={18} /><span dir="ltr">{site.contact.phone}</span></a></li>}
            {mailUrl && <li><a href={mailUrl} data-cta-location="footer"><Icon name="mail" size={18} />{site.contact.email}</a></li>}
            {site.contact.address && <li>{site.contact.address}</li>}
            {site.contact.hours && <li>{site.contact.hours}</li>}
          </ul>
        </div>
      )}
      {socials.length > 0 && (
        <div>
          <h2 class="ftr__h">רשתות</h2>
          <ul role="list" class="ftr__social">
            {socials.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" aria-label={socialLabel[k] || k}><Icon name={k} size={20} /></a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div class="ftr__bottom">
      <p>© {year} {site.brand.legalName || site.brand.name}</p>
      <ul role="list" class="ftr__legal">
        {legal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        {consentEnabled && <li><button type="button" data-open-consent>הגדרות עוגיות</button></li>}
      </ul>
    </div>
  </div>
</footer>

<style>
  .ftr { background: var(--black); color: #c7ccd2; padding-top: clamp(3.5rem, 6vw, 5.5rem); }
  .ftr__top { display: grid; gap: 2.5rem; padding-bottom: 3rem; }
  .ftr__brand { display: grid; gap: 1rem; justify-items: start; max-width: 24rem; }
  .ftr__logo { text-decoration: none; }
  .ftr__h { font-size: var(--t-sm); font-weight: 600; color: var(--white); margin-bottom: 0.75rem; }
  .ftr ul a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; text-decoration: none; }
  .ftr ul a:hover { color: var(--orange); }
  .ftr__social { display: flex; gap: 0.5rem; }
  .ftr__social a { width: 44px; height: 44px; justify-content: center; border: 1px solid #3a3a3a; border-radius: 50%; }
  .ftr__bottom { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; justify-content: space-between; align-items: center; padding-block: 1.5rem; border-top: 1px solid #2b2b2b; font-size: var(--t-sm); }
  .ftr__legal { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .ftr__legal a, .ftr__legal button { background: none; border: 0; padding: 0; min-height: 40px; display: inline-flex; align-items: center; font-size: inherit; text-decoration: underline; text-underline-offset: 4px; color: inherit; }
  .ftr__legal a:hover, .ftr__legal button:hover { color: var(--orange); }
  @media (min-width: 900px) { .ftr__top { grid-template-columns: 1.4fr 1fr 1.2fr 0.8fr; } }
  @media (max-width: 899px) { .ftr { padding-bottom: 4.75rem; } }
</style>
