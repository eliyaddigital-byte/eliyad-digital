---
import { services, servicesSection } from '../content/home';
const groups = servicesSection.categories.map((c) => ({ ...c, items: services.filter((s) => s.category === c.id) }));
const blurbs: Record<string, string> = {
  ads: 'ניהול הקמפיינים עצמם, בכל ערוץ שבו הלקוחות שלך נמצאים.',
  growth: 'מה שקורה לפני ואחרי הקליק: מסר, משפך ודף נחיתה שממירים.',
  data: 'התשתית שמאפשרת לדעת מה עובד: מדידה, דוחות וחיבורי מערכות.',
};
---
<section class="band services" id="services" aria-labelledby="services-title" data-section="services">
  <div class="wrap">
    <div class="section-intro">
      <h2 id="services-title" class="h-section">{servicesSection.title}</h2>
      <p class="lede">{servicesSection.subtitle}</p>
    </div>
    <div class="svc-groups">
      {groups.map((g) => (
        <section class="svc-group" aria-labelledby={`svc-${g.id}`}>
          <h3 id={`svc-${g.id}`} class="svc-group__title">{g.label}</h3>
          <p class="svc-group__blurb">{blurbs[g.id]}</p>
          <ul role="list" class="svc-list">
            {g.items.map((s) => (
              <li>
                <details>
                  <summary><span>{s.title}</span><span class="svc-list__plus" aria-hidden="true"></span></summary>
                  <div class="svc-list__body">
                    <p>{s.value}</p>
                    <ul>{s.gets.map((x) => <li>{x}</li>)}</ul>
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .svc-groups { display: grid; gap: 3rem; }
  .svc-group__title { font-family: var(--display); font-weight: 700; font-size: var(--d-sm); line-height: 1; padding-top: 1rem; border-top: 3px solid var(--black); }
  .svc-group__blurb { color: var(--slate); margin-top: 0.6rem; min-height: 3.2em; }
  .svc-list { margin-top: 1.25rem; }
  .svc-list > li { border-bottom: 1px solid var(--line); }
  .svc-list summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 0; cursor: pointer; font-weight: 600; font-size: var(--t-md); }
  .svc-list summary::-webkit-details-marker { display: none; }
  .svc-list summary:hover span:first-child { color: var(--ember); }
  .svc-list__plus { position: relative; flex: none; width: 14px; height: 14px; }
  .svc-list__plus::before, .svc-list__plus::after { content: ''; position: absolute; inset: 6px 0 auto; height: 2px; background: currentColor; transition: transform 200ms var(--ease); }
  .svc-list__plus::after { transform: rotate(90deg); }
  details[open] .svc-list__plus::after { transform: rotate(0deg); }
  .svc-list__body { padding: 0 0 1.25rem; color: var(--slate); }
  .svc-list__body ul { margin-top: 0.6rem; padding-inline-start: 1.1rem; display: grid; gap: 0.25rem; }
  .svc-list__body li::marker { color: var(--orange); }
  details[open] .svc-list__body { animation: open 260ms var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-4px); } }
  @media (min-width: 960px) { .svc-groups { grid-template-columns: repeat(3, 1fr); gap: 3rem; } }
</style>
