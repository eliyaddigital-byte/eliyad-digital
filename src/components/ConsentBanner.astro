---
/**
 * באנר הסכמה לעוגיות (Consent Mode v2).
 * מוצג רק כשמוגדר לפחות כלי מדידה אחד ב-site.analytics – אחרת האתר לא משתמש בעוגיות מעקב ואין צורך בבאנר.
 */
import { site } from '../config/site';
const enabled = Boolean(site.analytics.gtmId || site.analytics.ga4Id || site.analytics.clarityId);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{enabled && (
  <div class="consent" data-consent hidden role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-desc">
    <div class="consent__inner">
      <div class="consent__text">
        <p id="consent-title" class="consent__title">פרטיות ועוגיות</p>
        <p id="consent-desc">
          אנחנו משתמשים בעוגיות למדידת ביצועי האתר ולשיפור הפרסום. אפשר לאשר הכל, לדחות, או לבחור.
          <a href={`${base}privacy/`}>מדיניות פרטיות</a>
        </p>
        <div class="consent__prefs" data-consent-prefs hidden>
          <label class="check"><input type="checkbox" checked disabled /> <span><strong>הכרחיות</strong> – תפקוד בסיסי של האתר</span></label>
          <label class="check"><input type="checkbox" data-consent-analytics /> <span><strong>סטטיסטיקה</strong> – הבנת השימוש באתר (Google Analytics, Clarity)</span></label>
          <label class="check"><input type="checkbox" data-consent-marketing /> <span><strong>שיווק</strong> – מדידת קמפיינים ופרסום מותאם (Google Ads, Meta, TikTok, LinkedIn)</span></label>
        </div>
      </div>
      <div class="consent__actions">
        <button type="button" class="btn btn--primary" data-consent-accept>אישור הכל</button>
        <button type="button" class="btn btn--ghost" data-consent-reject>דחייה</button>
        <button type="button" class="consent__more" data-consent-customize aria-expanded="false">התאמה אישית</button>
        <button type="button" class="btn btn--ghost" data-consent-save hidden>שמירת הבחירה</button>
      </div>
    </div>
  </div>
)}

<script>
  import { getConsent, setConsent } from '../scripts/tracking';
  const box = document.querySelector<HTMLElement>('[data-consent]');
  if (box) {
    const prefs = box.querySelector<HTMLElement>('[data-consent-prefs]')!;
    const a = box.querySelector<HTMLInputElement>('[data-consent-analytics]')!;
    const m = box.querySelector<HTMLInputElement>('[data-consent-marketing]')!;
    const save = box.querySelector<HTMLButtonElement>('[data-consent-save]')!;
    const custom = box.querySelector<HTMLButtonElement>('[data-consent-customize]')!;
    const open = () => {
      const c = getConsent();
      a.checked = Boolean(c?.analytics); m.checked = Boolean(c?.marketing);
      box.hidden = false;
    };
    const close = () => { box.hidden = true; };
    if (!getConsent()) open();
    box.querySelector('[data-consent-accept]')!.addEventListener('click', () => { setConsent(true, true); close(); });
    box.querySelector('[data-consent-reject]')!.addEventListener('click', () => { setConsent(false, false); close(); });
    custom.addEventListener('click', () => {
      const show = prefs.hidden;
      prefs.hidden = !show; save.hidden = !show; custom.setAttribute('aria-expanded', String(show));
    });
    save.addEventListener('click', () => { setConsent(a.checked, m.checked); close(); });
    document.querySelectorAll('[data-open-consent]').forEach((b) => b.addEventListener('click', open));
  }
</script>

<style>
  .consent {
    position: fixed; z-index: 90; inset-inline: 12px; bottom: 12px;
    max-width: 760px; margin-inline: auto;
    background: var(--white); border: 2px solid var(--ink); border-radius: var(--radius);
    box-shadow: var(--shadow-hard-orange);
  }
  .consent__inner { display: grid; gap: 1rem; padding: 1.25rem; }
  .consent__title { font-weight: 800; font-size: var(--fs-lg); margin-bottom: 0.25rem; }
  .consent__text p { font-size: var(--fs-sm); color: var(--ink-soft); }
  .consent__text a { color: var(--ink); font-weight: 600; }
  .consent__prefs { display: grid; gap: 0.6rem; margin-top: 0.9rem; }
  .consent__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; }
  .consent__actions .btn { min-height: 46px; padding: 0.6rem 1.2rem; }
  .consent__more { background: none; border: 0; text-decoration: underline; font-weight: 600; padding: 0.5rem; min-height: 44px; }
</style>
