---
import Icon from './Icon.astro';
import { benefitsSection, fitSection } from '../content/home';
import { mark } from '../lib/text';
---
<section class="section benefits" id="why" aria-labelledby="why-title" data-section="why">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{benefitsSection.eyebrow}</p>
      <h2 id="why-title" set:html={mark(benefitsSection.title)} />
    </div>
    <ul class="benefits__grid" role="list">
      {benefitsSection.items.map((b, i) => (
        <li class="benefit" data-reveal style={`--i:${i % 4}`}>
          <span class="benefit__icon"><Icon name={b.icon} size={24} /></span>
          <h3>{b.title}</h3>
          <p>{b.text}</p>
        </li>
      ))}
    </ul>

    <div class="fit" id="fit" aria-labelledby="fit-title">
      <div class="fit__head" data-reveal>
        <p class="eyebrow">{fitSection.eyebrow}</p>
        <h2 id="fit-title" set:html={mark(fitSection.title)} />
      </div>
      <div class="fit__cols">
        <div class="fit__col fit__col--yes" data-reveal>
          <h3>{fitSection.fit.title}</h3>
          <ul role="list">{fitSection.fit.items.map((t) => <li><span class="fit__ic"><Icon name="check" size={16} stroke={3} /></span>{t}</li>)}</ul>
        </div>
        <div class="fit__col fit__col--no" data-reveal style="--i:1">
          <h3>{fitSection.notFit.title}</h3>
          <ul role="list">{fitSection.notFit.items.map((t) => <li><span class="fit__ic"><Icon name="x" size={16} stroke={3} /></span>{t}</li>)}</ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .benefits__grid { display: grid; gap: 1px; background: var(--ink); border: 2px solid var(--ink); border-radius: var(--radius); overflow: hidden; grid-template-columns: 1fr; }
  .benefit { background: var(--paper); padding: 1.75rem 1.5rem; transition: background var(--dur); }
  .benefit:hover { background: var(--white); }
  .benefit__icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 2px solid var(--ink); margin-bottom: 1rem; transition: background var(--dur), transform var(--dur) var(--ease-out); }
  .benefit:hover .benefit__icon { background: var(--orange); transform: translateY(-3px); }
  .benefit h3 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .benefit p { color: var(--ink-soft); font-size: var(--fs-sm); }
  @media (min-width: 640px) { .benefits__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .benefits__grid { grid-template-columns: repeat(4, 1fr); } }

  .fit { margin-top: clamp(4rem, 7vw, 7rem); display: grid; gap: 2rem; }
  .fit__head h2 { font-size: var(--fs-h2); }
  .fit__cols { display: grid; gap: 1.25rem; }
  .fit__col { padding: 1.75rem; border-radius: var(--radius); border: 2px solid var(--ink); }
  .fit__col h3 { font-size: var(--fs-h3); margin-bottom: 1.1rem; }
  .fit__col ul { display: grid; gap: 0.8rem; }
  .fit__col li { display: flex; gap: 0.7rem; align-items: flex-start; font-weight: 500; }
  .fit__ic { flex: none; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; margin-top: 0.1rem; }
  .fit__col--yes { background: var(--white); box-shadow: var(--shadow-hard-orange); }
  .fit__col--yes .fit__ic { background: var(--orange); }
  .fit__col--no { background: transparent; border-style: dashed; border-color: #a59d8f; }
  .fit__col--no .fit__ic { background: var(--paper-2); color: var(--ink-soft); }
  .fit__col--no li { color: var(--ink-soft); }
  @media (min-width: 900px) {
    .fit { grid-template-columns: 0.8fr 1.2fr; align-items: center; }
    .fit__cols { grid-template-columns: 1.1fr 0.9fr; }
  }
</style>
