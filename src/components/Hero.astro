---
/**
 * Hero – "billboard" headline on the orange field + an interactive
 * cost-per-customer calculator (the number performance marketing is really about).
 * The calculator only computes from the visitor's own inputs – no claims, no invented data.
 */
import Icon from './Icon.astro';
import { hero, platforms } from '../content/home';
import { withBase } from '../lib/text';
const adIcons = platforms.filter((p) => p.group === 'ads' && p.icon);
import { site, whatsappUrl, telUrl, leadFormActive } from '../config/site';
import { plain } from '../lib/text';
const variants = Object.entries(hero.headlines);
const waBase = site.contact.whatsapp ? `https://wa.me/${site.contact.whatsapp}` : '';
---
<section class="hero" id="top" data-hero data-section="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
    <h1 id="hero-title" class="hero__title display" data-experiment="hero_headline">
      {variants.map(([key, text], i) => {
        const lines = plain(text).split(/(?<=\.)\s+/);
        return (
          <span data-variant={key} hidden={i !== 0}>
            {lines.map((l, j) => <span class="hero__line" style={`--d:${j * 110}ms`}>{l}</span>)}
          </span>
        );
      })}
    </h1>
        <p class="hero__sub">{hero.subheadline}</p>
        <div class="hero__ctas">
          {whatsappUrl ? (
            <a class="btn btn--black btn--lg" href={whatsappUrl} target="_blank" rel="noopener" data-cta="hero-whatsapp"><Icon name="whatsapp" size={22} />שליחת הודעה בוואטסאפ</a>
          ) : (
            <a class="btn btn--black btn--lg" href="#contact" data-cta="hero-primary">{site.cta.primary}</a>
          )}
        </div>
        <div class="hero__tools">
          <p>מנהלים קמפיינים ב-</p>
          <ul role="list">
            {adIcons.map((p) => <li><img src={withBase(`icons/${p.icon}.svg`)} alt={p.name} width="28" height="28" loading="eager" decoding="async" /></li>)}
          </ul>
        </div>
      </div>

      <div class="calc" role="group" data-calc data-wa={waBase} aria-labelledby="calc-title">
        <p id="calc-title" class="calc__title">כמה עולה לך לקוח חדש?</p>

        <div class="calc__row">
          <label for="calc-budget">תקציב פרסום בחודש</label>
          <output for="calc-budget" data-out="budget">10,000 ₪</output>
          <input id="calc-budget" type="range" min="1000" max="100000" step="500" value="10000" data-in="budget" />
        </div>
        <div class="calc__row">
          <label for="calc-leads">פניות (לידים) בחודש</label>
          <output for="calc-leads" data-out="leads">80</output>
          <input id="calc-leads" type="range" min="5" max="1000" step="5" value="80" data-in="leads" />
        </div>
        <div class="calc__row">
          <label for="calc-close">מתוכן הופכות ללקוחות</label>
          <output for="calc-close" data-out="close">10%</output>
          <input id="calc-close" type="range" min="1" max="60" step="1" value="10" data-in="close" />
        </div>

        <dl class="calc__results" aria-live="polite">
          <div><dt>עלות לליד</dt><dd data-res="cpl">125 ₪</dd></div>
          <div><dt>לקוחות בחודש</dt><dd data-res="customers">8</dd></div>
          <div class="calc__main"><dt>עלות ללקוח</dt><dd data-res="cpa">1,250 ₪</dd></div>
        </dl>
        <p class="calc__insight" data-res="insight">אם עוד 2% מהפניות ייסגרו, העלות ללקוח תרד ל-1,042 ₪ באותו תקציב.</p>
        {waBase && (
          <a class="btn btn--orange btn--block" href={whatsappUrl} target="_blank" rel="noopener" data-calc-wa data-cta="calc-whatsapp">
            <Icon name="whatsapp" size={20} />שליחת הודעה בוואטסאפ
          </a>
        )}
        {waBase && <p class="calc__note">ההודעה תכלול את החישוב שלכם.</p>}
      </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLElement>('[data-calc]');
  if (form) {
    const nf = new Intl.NumberFormat('he-IL', { maximumFractionDigits: 0 });
    const ils = (n: number) => `${nf.format(Math.round(n))} ₪`;
    const get = (k: string) => Number(form.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value);
    const out = (k: string, v: string) => { form.querySelector(`[data-out="${k}"]`)!.textContent = v; };
    const res = (k: string) => form.querySelector<HTMLElement>(`[data-res="${k}"]`)!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let shown = 1250;
    let raf = 0;
    let interacted = false;
    const wa = form.querySelector<HTMLAnchorElement>('[data-calc-wa]');

    const tween = (to: number) => {
      cancelAnimationFrame(raf);
      if (reduce) { shown = to; res('cpa').textContent = ils(to); return; }
      const from = shown; const t0 = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / 320);
        shown = from + (to - from) * (1 - (1 - p) ** 3);
        res('cpa').textContent = ils(shown);
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    const paintTrack = (el: HTMLInputElement) => {
      const p = ((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100;
      el.style.setProperty('--p', `${p}%`);
    };

    const update = () => {
      const budget = get('budget'), leads = get('leads'), close = get('close');
      out('budget', ils(budget)); out('leads', nf.format(leads)); out('close', `${close}%`);
      const customers = (leads * close) / 100;
      const cpl = budget / leads;
      const cpa = customers > 0 ? budget / customers : 0;
      res('cpl').textContent = ils(cpl);
      res('customers').textContent = customers >= 10 ? nf.format(customers) : customers.toFixed(1).replace(/\.0$/, '');
      tween(cpa);
      const better = Math.min(close + 2, 100);
      const cpaBetter = budget / ((leads * better) / 100);
      res('insight').textContent = `אם עוד 2% מהפניות ייסגרו, העלות ללקוח תרד ל-${ils(cpaBetter)} באותו תקציב.`;
      if (wa && form.dataset.wa) {
        const msg = `היי BoostRize, עשיתי חישוב באתר: תקציב פרסום ${ils(budget)} בחודש, ${nf.format(leads)} פניות, ${close}% נסגרות. עלות ללקוח: ${ils(cpa)}. אשמח לבדוק איך משפרים את זה.`;
        wa.href = `${form.dataset.wa}?text=${encodeURIComponent(msg)}`;
      }
      form.querySelectorAll<HTMLInputElement>('input[type=range]').forEach(paintTrack);
    };
    form.addEventListener('input', () => {
      update();
      if (!interacted) { interacted = true; window.__brTrack?.('calculator_use', { form_id: 'cpa_calculator' }); }
    });
    update();
  }
</script>

<style>
  .hero { background: var(--orange); padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3rem, 2rem + 3vw, 4.5rem); }
  @media (min-width: 960px) { .hero { min-height: calc(100svh - var(--header-h)); display: grid; align-items: center; } }
  .hero__title { font-size: var(--d-xl); }
  .hero__title > span[hidden] { display: none; }
  .hero__title > span { display: block; }
  .hero__line { display: block; animation: lineIn 760ms var(--ease) both; animation-delay: var(--d); }
  @keyframes lineIn { from { opacity: 0; transform: translateY(0.35em); } }

  .hero__grid { display: grid; gap: clamp(2.5rem, 4vw, 4.5rem); align-items: center; }
  .hero__copy { display: grid; align-content: center; }
  .hero__sub { margin-top: 1.75rem; font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem); line-height: 1.5; max-width: 34ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 2.25rem; font-weight: 500; }
  .hero__tools ul { display: flex; gap: 0.5rem; }
  .hero__tools li { width: 46px; height: 46px; display: grid; place-items: center; background: var(--white); border-radius: 12px; }
  .hero__tools img { width: 26px; height: 26px; object-fit: contain; }

  /* Calculator panel */
  .calc { background: var(--black); color: var(--white); border-radius: var(--r-panel); padding: clamp(1.5rem, 1rem + 1.6vw, 2.25rem); display: grid; gap: 0.9rem; animation: panelIn 900ms var(--ease) 280ms both; }
  @keyframes panelIn { from { opacity: 0; transform: translateY(24px); } }
  .calc__title { font-family: var(--display); font-weight: 700; font-size: var(--d-sm); line-height: 1; }
  .calc__note { color: #a9afb7; font-size: var(--t-sm); margin-top: -0.4rem; text-align: center; }
  .calc__row { display: grid; grid-template-columns: 1fr auto; gap: 0.35rem 1rem; align-items: baseline; }
  .calc__row label { font-size: var(--t-sm); color: #d4d8dd; }
  .calc__row output { font-weight: 600; font-variant-numeric: tabular-nums; }
  .calc__row input { grid-column: 1 / -1; }

  .calc input[type='range'] {
    --p: 50%;
    -webkit-appearance: none; appearance: none; width: 100%; height: 28px; background: transparent; margin: 0;
  }
  .calc input[type='range']::-webkit-slider-runnable-track { height: 6px; border-radius: 6px; background: linear-gradient(to left, var(--orange) var(--p), #3a3a3a var(--p)); }
  .calc input[type='range']::-moz-range-track { height: 6px; border-radius: 6px; background: #3a3a3a; }
  .calc input[type='range']::-moz-range-progress { height: 6px; border-radius: 6px; background: var(--orange); }
  .calc input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; border-radius: 50%; background: var(--white); border: 4px solid var(--orange); margin-top: -9px; }
  .calc input[type='range']::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--white); border: 4px solid var(--orange); }
  .calc input[type='range']:focus-visible { outline: 2px solid var(--white); outline-offset: 4px; box-shadow: none; }

  .calc__results { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; margin-top: 0.25rem; border-top: 1px solid #333; }
  .calc__results > div { padding: 0.8rem 0; }
  .calc__results dt { font-size: var(--t-sm); color: #a9afb7; }
  .calc__results dd { font-weight: 600; font-size: var(--t-md); font-variant-numeric: tabular-nums; }
  .calc__main { grid-column: 1 / -1; border-top: 1px solid #333; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .calc__main dt { font-size: var(--t-base); color: var(--white); font-weight: 600; }
  .calc__main dd { font-family: var(--display); font-size: clamp(3rem, 2.4rem + 2.6vw, 4.5rem); line-height: 1; color: var(--orange); }
  .calc__insight { font-size: var(--t-sm); color: #d4d8dd; }

  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1fr minmax(380px, 470px); }
  }
  @media (max-width: 600px) {
    .hero__ctas .btn { width: 100%; }
  }
</style>
