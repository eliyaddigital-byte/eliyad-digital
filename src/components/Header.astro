---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../config/site';
import { withBase } from '../lib/text';

interface Props { home?: boolean }
const { home = true } = Astro.props;
const h = (id: string) => (home ? `#${id}` : `${withBase('/')}#${id}`);
const links = [
  { label: 'שירותים', href: h('services') },
  { label: 'איך עובדים', href: h('process') },
  { label: 'למי זה מתאים', href: h('fit') },
  { label: 'אודות', href: h('about') },
  { label: 'שאלות', href: h('faq') },
];
const cta = whatsappUrl
  ? { href: whatsappUrl, label: 'וואטסאפ', ext: true }
  : { href: h('contact'), label: site.cta.primaryShort, ext: false };
---
<header class:list={['hdr', { 'hdr--home': home }]} data-header>
  <div class="wrap hdr__bar">
    <a class="hdr__logo" href={home ? '#top' : withBase('/')}><Logo size="sm" /></a>
    <nav class="hdr__nav" aria-label="ניווט ראשי" data-nav>
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="hdr__actions">
      <a class="btn btn--black hdr__cta" href={cta.href} target={cta.ext ? '_blank' : undefined} rel={cta.ext ? 'noopener' : undefined} data-cta="header" data-cta-location="header">
        {cta.ext && <Icon name="whatsapp" size={18} />}{cta.label}
      </a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="פתיחת תפריט" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="mmenu" hidden>
    <nav class="wrap" aria-label="ניווט במובייל">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={h('contact')}>יצירת קשר</a></li>
      </ul>
      {whatsappUrl && (
        <a class="btn btn--black btn--lg btn--block" href={whatsappUrl} target="_blank" rel="noopener" data-cta="mobile-menu" data-cta-location="mobile-menu"><Icon name="whatsapp" size={20} />שליחת הודעה בוואטסאפ</a>
      )}
    </nav>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 80; background: var(--white); transition: background-color 200ms var(--ease), box-shadow 200ms var(--ease); }
  .hdr--home { background: var(--orange); --logo-accent: var(--black); }
  .hdr:global(.is-scrolled) { background: var(--white); box-shadow: 0 1px 0 var(--line); --logo-accent: var(--orange); }
  .hdr__bar { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .hdr__logo { display: inline-flex; text-decoration: none; padding: 4px 0; }
  .hdr__nav { display: none; }
  .hdr__nav ul { display: flex; gap: 2rem; }
  .hdr__nav a { text-decoration: none; font-weight: 500; padding: 0.5rem 0; background: linear-gradient(currentColor, currentColor) no-repeat right bottom / 0 2px; transition: background-size 220ms var(--ease); }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { background-size: 100% 2px; }
  .hdr__actions { display: flex; align-items: center; gap: 0.6rem; }
  .hdr__cta { min-height: 44px; padding: 0.5rem 1.15rem; font-size: var(--t-sm); }
  .hdr__burger { width: 46px; height: 46px; display: grid; place-content: center; gap: 7px; background: transparent; border: 2px solid var(--black); border-radius: var(--r-pill); }
  .hdr__burger span { width: 18px; height: 2px; background: var(--black); transition: transform 220ms var(--ease); }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(4.5px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { transform: translateY(-4.5px) rotate(-45deg); }
  .mmenu { position: fixed; inset: var(--header-h) 0 0; background: var(--white); overflow-y: auto; padding-block: 1rem 2rem; }
  .mmenu ul { margin-bottom: 2rem; }
  .mmenu li a { display: block; padding: 0.7rem 0; font-family: var(--display); font-weight: 800; font-size: 1.9rem; line-height: 1.2; text-decoration: none; }
  @media (min-width: 1024px) {
    .hdr__nav { display: block; }
    .hdr__burger, .mmenu { display: none; }
  }
</style>
