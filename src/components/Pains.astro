---
import { pains } from '../content/home';
---
<section class="band pains" id="pains" aria-labelledby="pains-title" data-section="pains">
  <div class="wrap pains__grid">
    <div class="pains__head">
      <h2 id="pains-title" class="h-section">{pains.title}</h2>
      <p class="lede">אם לפחות אחד מהמשפטים כאן נשמע מוכר, כנראה שהבעיה לא בתקציב.</p>
    </div>
    <ul class="pains__list" role="list">
      {pains.items.map((p) => (
        <li>
          <p class="pains__t">{p.title}</p>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
  <div class="wrap">
    <p class="pains__closing">{pains.closing}</p>
  </div>
</section>

<style>
  .pains__grid { display: grid; gap: 2.5rem; }
  .pains__head { display: grid; gap: 1.25rem; align-content: start; }
  .pains__list { display: grid; grid-template-columns: 1fr; column-gap: 3rem; }
  .pains__list li { padding-block: 1.4rem; border-top: 1px solid var(--line); }
  .pains__t { font-size: var(--t-md); font-weight: 600; margin-bottom: 0.3rem; }
  .pains__list p:not(.pains__t) { color: var(--slate); }
  .pains__closing {
    margin-top: clamp(3rem, 2rem + 3vw, 5rem); padding-top: 2rem; border-top: 3px solid var(--black);
    font-family: var(--display); font-weight: 800; font-size: var(--d-sm); line-height: 1.05; max-width: 28ch;
  }
  @media (min-width: 720px) { .pains__list { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .pains__grid { grid-template-columns: 0.8fr 1.6fr; gap: 4rem; } }
</style>
