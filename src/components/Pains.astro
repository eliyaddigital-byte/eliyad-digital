---
import Icon from './Icon.astro';
import { pains } from '../content/home';
import { mark } from '../lib/text';
---
<section class="section pains" id="pains" aria-labelledby="pains-title" data-section="pains">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{pains.eyebrow}</p>
      <h2 id="pains-title" set:html={mark(pains.title)} />
    </div>
    <ol class="pains__list" role="list">
      {pains.items.map((p, i) => (
        <li class="pains__item" data-reveal style={`--i:${i % 4}`}>
          <span class="pains__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="pains__icon"><Icon name={p.icon} size={26} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
      <li class="pains__item pains__item--answer" data-reveal style="--i:3">
        <p class="pains__closing">{pains.closing}</p>
        <a class="link-arrow" href="#services" data-cta="pains-to-services">ככה אנחנו פותרים את זה <Icon name="arrow-left" size={18} /></a>
      </li>
    </ol>
  </div>
</section>

<style>
  .pains__list { display: grid; grid-template-columns: 1fr; border-top: 2px solid var(--ink); }
  .pains__item { position: relative; padding: 2rem 0.5rem 2rem 2.5rem; border-bottom: 1px solid var(--line); transition: background var(--dur); }
  .pains__item:hover { background: var(--white); }
  .pains__num { position: absolute; inset-inline-end: 0.75rem; top: 1.75rem; font-weight: 800; font-size: 0.85rem; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .pains__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--orange-50); color: var(--orange-ink); margin-bottom: 1rem; transition: transform var(--dur) var(--ease-out), background var(--dur), color var(--dur); }
  .pains__item:hover .pains__icon { transform: rotate(-12deg) scale(1.06); background: var(--orange); color: var(--ink); }
  .pains__item h3 { font-size: var(--fs-h3); margin-bottom: 0.5rem; }
  .pains__item p { color: var(--ink-soft); }
  .pains__item--answer { background: var(--ink); color: var(--paper); padding: 2rem 1.75rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; border-bottom: 0; }
  .pains__item--answer:hover { background: var(--ink); }
  .pains__item--answer .pains__closing { font-size: var(--fs-lg); font-weight: 600; line-height: 1.45; color: var(--paper); }
  .pains__item--answer .link-arrow { color: var(--orange); }
  @media (min-width: 700px) {
    .pains__list { grid-template-columns: repeat(2, 1fr); }
    .pains__item { padding-inline: 1.75rem 3rem; }
    .pains__item:nth-child(odd) { border-inline-end: 1px solid var(--line); }
  }
  @media (min-width: 1100px) {
    .pains__list { grid-template-columns: repeat(4, 1fr); }
    .pains__item, .pains__item:nth-child(odd) { border-inline-end: 1px solid var(--line); }
    .pains__item:nth-child(4n) { border-inline-end: 0; }
  }
</style>
