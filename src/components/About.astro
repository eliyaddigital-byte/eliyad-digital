---
import Logo from './Logo.astro';
import { aboutSection } from '../content/home';
import { mark, withBase } from '../lib/text';
const f = aboutSection.founder;
---
<section class="section section--white about" id="about" aria-labelledby="about-title" data-section="about">
  <div class="container about__layout">
    <div class="about__copy">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{aboutSection.eyebrow}</p>
        <h2 id="about-title" set:html={mark(aboutSection.title)} />
      </div>
      <div class="about__text" data-reveal>
        {aboutSection.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <ul class="about__values" role="list">
        {aboutSection.values.map((v, i) => (
          <li data-reveal style={`--i:${i}`}><strong>{v.title}</strong><span>{v.text}</span></li>
        ))}
      </ul>
    </div>

    <div class="about__visual" data-reveal>
      {f.image ? (
        <figure class="founder">
          <img src={withBase(f.image)} alt={f.name ? `${f.name}${f.role ? `, ${f.role}` : ''}` : 'המייסד'} width="560" height="680" loading="lazy" decoding="async" />
          {f.name && <figcaption><strong>{f.name}</strong>{f.role && <span>{f.role}</span>}{f.bio && <p>{f.bio}</p>}</figcaption>}
        </figure>
      ) : (
        <div class="brandart" aria-hidden="true">
          <div class="brandart__ring"></div>
          <div class="brandart__mark"><Logo markOnly size="lg" /></div>
          <span class="brandart__tag brandart__tag--1">אסטרטגיה</span>
          <span class="brandart__tag brandart__tag--2">פרסום</span>
          <span class="brandart__tag brandart__tag--3">מדידה</span>
          <span class="brandart__tag brandart__tag--4">אוטומציה</span>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about__layout { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: center; }
  .about__text { display: grid; gap: 1.1rem; font-size: var(--fs-lg); color: var(--ink-2); max-width: 40rem; }
  .about__text p:first-child { font-weight: 600; color: var(--ink); }
  .about__values { margin-top: 2.25rem; display: grid; gap: 0.75rem; }
  .about__values li { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; align-items: baseline; padding: 0.9rem 0; border-top: 1px solid var(--line); }
  .about__values strong { font-size: 1.2rem; font-weight: 800; }
  .about__values strong::before { content: ''; display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--orange); margin-inline-end: 0.5rem; }
  .about__values span { color: var(--ink-soft); }

  .brandart { position: relative; aspect-ratio: 1; max-width: 480px; margin-inline: auto; display: grid; place-items: center; }
  .brandart__ring { position: absolute; inset: 6%; border-radius: 50%; border: 2px dashed var(--ink); animation: spin 60s linear infinite; }
  .brandart__mark { width: 52%; aspect-ratio: 1; display: grid; place-items: center; background: var(--ink); border-radius: 50%; box-shadow: 14px 14px 0 var(--orange); }
  .brandart__mark :global(.logo) { font-size: clamp(4rem, 12vw, 7.5rem); }
  .brandart__tag { position: absolute; background: var(--paper); border: 2px solid var(--ink); border-radius: var(--radius-pill); padding: 0.35rem 1rem; font-weight: 700; font-size: 0.95rem; animation: bob 6s ease-in-out infinite; }
  .brandart__tag--1 { top: 6%; inset-inline-start: 8%; }
  .brandart__tag--2 { top: 20%; inset-inline-end: 0; animation-delay: -1.5s; background: var(--orange); }
  .brandart__tag--3 { bottom: 14%; inset-inline-start: 0; animation-delay: -3s; background: var(--ink); color: var(--white); }
  .brandart__tag--4 { bottom: 4%; inset-inline-end: 12%; animation-delay: -4.5s; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes bob { 50% { translate: 0 -8px; } }

  .founder { position: relative; max-width: 460px; margin-inline: auto; }
  .founder img { border: 2px solid var(--ink); border-radius: var(--radius); box-shadow: 14px 14px 0 var(--orange); object-fit: cover; aspect-ratio: 14 / 17; }
  .founder figcaption { position: absolute; inset-inline-start: -1rem; bottom: 1.5rem; background: var(--ink); color: var(--white); padding: 0.8rem 1.1rem; border-radius: var(--radius); display: grid; max-width: 80%; }
  .founder figcaption span { color: var(--orange); font-size: var(--fs-sm); }
  .founder figcaption p { font-size: var(--fs-sm); color: #ccc; margin-top: 0.3rem; }
  @media (min-width: 1024px) { .about__layout { grid-template-columns: 1.15fr 0.85fr; } }
  @media (max-width: 480px) { .about__values li { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
