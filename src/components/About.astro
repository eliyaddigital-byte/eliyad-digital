---
import { aboutSection, platforms, platformsSection } from '../content/home';
import { withBase } from '../lib/text';
const f = aboutSection.founder;
---
<section class="band about" id="about" aria-labelledby="about-title" data-section="about">
  <div class="wrap about__layout">
    <div class="about__main">
      <h2 id="about-title" class="h-section">{aboutSection.title}</h2>
      <div class="about__text">
        {aboutSection.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <dl class="about__values">
        {aboutSection.values.map((v) => <div><dt>{v.title}</dt><dd>{v.text}</dd></div>)}
      </dl>
    </div>
    <aside class="about__side" aria-labelledby="platforms-title">
      {f.image && (
        <figure class="founder">
          <img src={withBase(f.image)} alt={f.name ? `${f.name}${f.role ? `, ${f.role}` : ''}` : 'המייסד'} width="560" height="680" loading="lazy" decoding="async" />
          {f.name && <figcaption><strong>{f.name}</strong>{f.role && <span>{f.role}</span>}</figcaption>}
        </figure>
      )}
      <p id="platforms-title" class="about__side-title">{platformsSection.title}</p>
      <ul role="list" class="platforms">
        {platforms.map((p) => <li dir="ltr">{p.icon && <img src={withBase(`icons/${p.icon}.svg`)} alt="" width="18" height="18" loading="lazy" decoding="async" />}{p.name}</li>)}
      </ul>
      <p class="platforms__note">{platformsSection.note}</p>
    </aside>
  </div>
</section>

<style>
  .about__layout { display: grid; gap: 3.5rem; }
  .about__main { display: grid; gap: 2rem; align-content: start; }
  .about__text { display: grid; gap: 1rem; font-size: var(--t-md); max-width: 58ch; }
  .about__text p:not(:first-child) { color: var(--slate); }
  .about__values { display: grid; gap: 0; border-top: 3px solid var(--black); }
  .about__values > div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .about__values dt { font-weight: 600; }
  .about__values dd { color: var(--slate); }
  .about__side { background: var(--fog); border-radius: var(--r-panel); padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); align-self: start; }
  .about__side-title { font-size: var(--t-md); font-weight: 600; margin-bottom: 1.25rem; }
  .platforms { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .platforms li { display: inline-flex; align-items: center; gap: 0.45rem; background: var(--white); border-radius: var(--r-pill); padding: 0.45rem 0.9rem; font-weight: 600; font-size: var(--t-sm); }
  .platforms img { width: 18px; height: 18px; object-fit: contain; }
  .platforms__note { margin-top: 1.25rem; font-size: 0.8125rem; color: var(--slate); }
  .founder { margin-bottom: 2rem; }
  .founder img { border-radius: var(--r-panel); object-fit: cover; aspect-ratio: 14 / 17; width: 100%; }
  .founder figcaption { display: grid; margin-top: 0.75rem; }
  .founder figcaption span { color: var(--slate); }
  @media (min-width: 1024px) { .about__layout { grid-template-columns: 1.4fr 0.9fr; gap: 5rem; } }
  @media (max-width: 480px) { .about__values > div { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
