---
/**
 * "Where measurement stops" – the funnel from ad to sale, showing what typical
 * reports cover vs. what we measure. Case studies render here only when verified.
 */
import { resultsSection } from '../content/home';
import { publishedCases } from '../content/proof';
import { withBase } from '../lib/text';

const stages = ['מודעה', 'קליק', 'ליד', 'שיחת מכירה', 'לקוח משלם'];
function chartPath(points: { y: number }[], w = 300, h = 110) {
  const max = Math.max(...points.map((p) => p.y), 1);
  const step = points.length > 1 ? w / (points.length - 1) : w;
  return points.map((p, i) => `${i === 0 ? 'M' : 'L'}${(i * step).toFixed(1)} ${(h - (p.y / max) * (h - 10)).toFixed(1)}`).join(' ');
}
---
<section class="band band--fog measure" id="results" aria-labelledby="measure-title" data-section="results">
  <div class="wrap">
    <div class="section-intro">
      <h2 id="measure-title" class="h-section">{resultsSection.title}</h2>
      <p class="lede">{resultsSection.subtitle}</p>
    </div>

    <figure class="funnel" aria-label="שלבי הדרך מהמודעה ללקוח, ומה נמדד בכל שלב">
      <ol class="funnel__stages" role="list">
        {stages.map((s, i) => <li class:list={{ 'is-end': i === stages.length - 1 }}><span>{s}</span></li>)}
      </ol>
      <div class="funnel__brackets">
        <p class="funnel__b funnel__b--typical"><span>מה שרוב הדוחות מראים</span><small> מודעה, קליק וליד</small></p>
        <p class="funnel__b funnel__b--ours"><span>מה שאנחנו מודדים ומשפרים</span><small> כל הדרך עד הלקוח המשלם</small></p>
      </div>
    </figure>

    <dl class="metrics">
      {resultsSection.metrics.map((m) => (
        <div>
          <dt><span dir="ltr">{m.key}</span> {m.name}</dt>
          <dd>{m.text}</dd>
        </div>
      ))}
    </dl>

    {publishedCases.length > 0 && (
      <div class="cases">
        <h3 class="cases__title">תוצאות של לקוחות</h3>
        <div class="cases__grid">
          {publishedCases.map((c) => (
            <article class="case">
              <header>
                {c.logo && <img src={withBase(c.logo)} alt={c.client} width="120" height="40" loading="lazy" decoding="async" />}
                <p class="case__industry">{c.industry}</p>
                <h4>{c.client}</h4>
                {(c.period || c.budget) && <p class="case__meta">{[c.period, c.budget && `תקציב: ${c.budget}`].filter(Boolean).join(', ')}</p>}
              </header>
              <dl class="case__metrics">
                {c.metrics.map((m) => <div><dt dir="auto">{m.label}</dt><dd>{m.before && <s>{m.before}</s>} <b>{m.after}</b></dd></div>)}
              </dl>
              {c.chart && c.chart.points.length > 1 && (
                <figure class="case__chart">
                  <svg viewBox="0 0 300 110" role="img" aria-label={`${c.chart.label}: ${c.chart.points.map((p) => `${p.x} ${p.y}`).join(', ')}`}>
                    <path d={chartPath(c.chart.points)} fill="none" stroke="#f37a1f" stroke-width="3" stroke-linecap="round" />
                  </svg>
                  <figcaption>{c.chart.label}</figcaption>
                </figure>
              )}
              <p><strong>האתגר: </strong>{c.challenge}</p>
              <p><strong>מה עשינו: </strong>{c.strategy}</p>
              <p class="case__outcome">{c.outcome}</p>
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .funnel { margin: 0; }
  .funnel__stages { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; }
  .funnel__stages li { position: relative; padding-block: 1.1rem; text-align: center; font-weight: 600; }
  .funnel__stages li span { position: relative; z-index: 1; display: inline-block; background: var(--white); border: 2px solid var(--black); border-radius: var(--r-pill); padding: 0.7rem 1.4rem; white-space: nowrap; font-size: var(--t-md); }
  .funnel__stages li::before { content: ''; position: absolute; top: 50%; inset-inline: 0; height: 2px; background: var(--black); }
  .funnel__stages li:first-child::before { inset-inline-start: 50%; }
  .funnel__stages li:last-child::before { inset-inline-end: 50%; }
  .funnel__stages li.is-end span { background: var(--orange); }

  .funnel__brackets { display: grid; grid-template-columns: repeat(5, 1fr); row-gap: 0.75rem; margin-top: 0.5rem; }
  .funnel__b { position: relative; padding-top: 1.1rem; font-size: var(--t-md); font-weight: 600; text-align: center; }
  .funnel__b::before { content: ''; position: absolute; top: 0; inset-inline: 10%; height: 0.6rem; border: 2px solid currentColor; border-top: 0; border-radius: 0 0 8px 8px; }
  .funnel__b--typical { grid-column: 1 / span 3; color: var(--slate); }
  .funnel__b--ours { grid-column: 1 / span 5; color: var(--black); }
  .funnel__b--ours span { background: var(--orange); padding: 0.2rem 0.8rem; border-radius: var(--r-pill); }
  .funnel__b--ours::before { color: var(--orange); }
  .funnel__b--ours::before { border-width: 3px; }

  .metrics { display: grid; gap: 0; margin-top: clamp(3rem, 2rem + 3vw, 5rem); border-top: 3px solid var(--black); }
  .metrics > div { padding: 1.25rem 0; border-bottom: 1px solid var(--line); display: grid; gap: 0.2rem; }
  .metrics dt { font-weight: 600; font-size: var(--t-md); }
  .metrics dt span { color: var(--ember); }
  .metrics dd { color: var(--slate); }

  .cases { margin-top: clamp(3rem, 5vw, 5rem); }
  .cases__title { font-family: var(--display); font-size: var(--d-sm); margin-bottom: 1.5rem; }
  .cases__grid { display: grid; gap: 1.25rem; }
  .case { background: var(--white); border-radius: var(--r-panel); padding: 1.75rem; display: grid; gap: 0.85rem; }
  .case__industry { font-size: var(--t-sm); font-weight: 600; color: var(--ember); }
  .case h4 { font-size: var(--t-lg); }
  .case__meta { font-size: var(--t-sm); color: var(--slate); }
  .case__metrics { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .case__metrics div { background: var(--fog); border-radius: var(--r-field); padding: 0.5rem 0.8rem; }
  .case__metrics dt { font-size: var(--t-sm); color: var(--slate); }
  .case__metrics b { font-size: var(--t-lg); }
  .case__chart svg { width: 100%; height: 100px; }
  .case__chart figcaption { font-size: var(--t-sm); color: var(--slate); }
  .case__outcome { font-weight: 600; }

  @media (min-width: 720px) { .metrics { grid-template-columns: repeat(2, 1fr); column-gap: 3rem; } }
  @media (min-width: 1100px) { .metrics { grid-template-columns: repeat(4, 1fr); } .metrics > div { border-bottom: 0; } .cases__grid { grid-template-columns: repeat(2, 1fr); } }
  .funnel__b small { display: none; }
  @media (max-width: 719px) {
    .funnel__stages { grid-template-columns: 1fr; }
    .funnel__stages li { text-align: start; padding-block: 0.35rem; }
    .funnel__stages li::before { top: 0; bottom: 0; height: auto; width: 2px; inset-inline-start: 1.6rem; inset-inline-end: auto; }
    .funnel__stages li:first-child::before { top: 50%; inset-inline-start: 1.6rem; }
    .funnel__stages li:last-child::before { bottom: 50%; inset-inline-end: auto; }
    .funnel__brackets { grid-template-columns: 1fr; margin-top: 1.5rem; row-gap: 0.75rem; }
    .funnel__b, .funnel__b--typical, .funnel__b--ours { grid-column: 1; text-align: start; padding: 0; }
    .funnel__b::before { display: none; }
    .funnel__b small { display: inline; font-weight: 400; font-size: var(--t-base); color: var(--slate); }
  }
</style>
