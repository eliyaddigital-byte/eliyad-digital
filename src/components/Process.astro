---
import MediaSlot from './MediaSlot.astro';
import { processSection } from '../content/home';
interface Props { preview?: boolean }
const { preview = false } = Astro.props;

import { whatsappUrl } from '../config/site';
---
<section class="band band--black process" id="process" aria-labelledby="process-title" data-section="process">
  <div class="wrap process__layout">
    <div class="process__intro">
      <h2 id="process-title" class="h-section">{processSection.title}</h2>
      <p class="lede">{processSection.subtitle}</p>
      <a class="btn btn--orange btn--lg" href={whatsappUrl || '#contact'} target={whatsappUrl ? '_blank' : undefined} rel={whatsappUrl ? 'noopener' : undefined} data-cta="process">מתחילים בשיחת היכרות</a>
      <MediaSlot id="process" preview={preview} class="process__media" alt="עבודה על אסטרטגיה" />
    </div>
    <ol class="steps" role="list">
      {processSection.steps.map((s, i) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="step__t">{s.title}</p>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__layout { display: grid; gap: 3rem; }
  .process__intro :global(.process__media) { width: 100%; margin-top: 1rem; }
  .process__intro { display: grid; gap: 1.5rem; justify-items: start; align-content: start; }
  .steps { counter-reset: s; }
  .step { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.25rem; padding-block: 1.5rem; border-top: 1px solid var(--line-dark); }
  .step__n { font-family: var(--display); font-weight: 700; font-size: 4.5rem; line-height: 0.8; color: var(--orange); }
  .step__t { font-size: var(--t-lg); font-weight: 600; margin-bottom: 0.35rem; }
  .step p:not(.step__t) { color: #b9bec5; max-width: 52ch; }
  @media (min-width: 1024px) {
    .process__layout { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; }
    .process__intro { position: sticky; top: calc(var(--header-h) + 3rem); }
  }
</style>
