---
import Icon from './Icon.astro';
import { processSection } from '../content/home';
import { mark } from '../lib/text';
---
<section class="section section--ink process" id="process" aria-labelledby="process-title" data-section="process">
  <div class="process__arrow-bg" aria-hidden="true">
    <svg viewBox="0 0 200 200"><path d="M170 170 40 40M40 40h90M40 40v90" fill="none" stroke="currentColor" stroke-width="22" stroke-linecap="square" /></svg>
  </div>
  <div class="container process__layout">
    <div class="process__intro">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{processSection.eyebrow}</p>
        <h2 id="process-title" set:html={mark(processSection.title)} />
        <p>{processSection.subtitle}</p>
      </div>
      <a class="btn btn--primary btn--lg" href="#contact" data-cta="process" data-reveal>מתחילים בשלב 1 <Icon name="arrow-left" size={20} class="btn__arrow" /></a>
    </div>

    <ol class="timeline" role="list" data-timeline>
      <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill"></span></span>
      {processSection.steps.map((s, i) => (
        <li class="step" data-reveal>
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <div class="step__body">
            <p class="step__label">שלב {i + 1}</p>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  if (tl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = tl.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
      tl.style.setProperty('--progress', p.toFixed(3));
      tl.querySelectorAll<HTMLElement>('.step').forEach((st) => {
        const sr = st.getBoundingClientRect();
        st.classList.toggle('is-active', sr.top < innerHeight * 0.6);
      });
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  } else tl?.style.setProperty('--progress', '1');
</script>

<style>
  .process { overflow: hidden; }
  .process__arrow-bg { position: absolute; inset-inline-start: -4%; bottom: -6%; width: min(46vw, 520px); color: #1c1c1c; pointer-events: none; }
  .process__layout { position: relative; display: grid; gap: 3rem; }
  .process__intro .btn { margin-top: 0.5rem; }
  .timeline { position: relative; display: grid; gap: 0.5rem; --progress: 0; }
  .timeline__rail { position: absolute; inset-inline-start: 27px; top: 28px; bottom: 28px; width: 3px; background: #2f2f2f; border-radius: 3px; }
  .timeline__fill { position: absolute; inset: 0; background: var(--orange); transform-origin: top; transform: scaleY(var(--progress)); }
  .step { position: relative; display: grid; grid-template-columns: 56px 1fr; gap: 1.25rem; padding-block: 1rem; }
  .step__num {
    position: relative; z-index: 1; width: 56px; height: 56px; display: grid; place-items: center;
    border-radius: 50%; background: var(--ink); border: 2px solid #4a4a4a; color: var(--paper); font-weight: 800; font-size: 1.25rem;
    transition: background var(--dur), border-color var(--dur), color var(--dur), transform var(--dur) var(--ease-out);
  }
  .step.is-active .step__num { background: var(--orange); border-color: var(--orange); color: var(--ink); transform: scale(1.06); }
  .step__body { padding: 0.5rem 1.25rem 1.25rem; border-radius: var(--radius); transition: background var(--dur); }
  .step:hover .step__body { background: #1a1a1a; }
  .step__label { font-size: var(--fs-xs); font-weight: 700; color: var(--orange); margin-bottom: 0.25rem; }
  .step h3 { font-size: var(--fs-h3); color: var(--white); margin-bottom: 0.4rem; }
  .step__body > p:last-child { color: #c9c4ba; }
  @media (min-width: 1024px) {
    .process__layout { grid-template-columns: 0.85fr 1.15fr; gap: 5rem; }
    .process__intro { position: sticky; top: calc(var(--header-h) + 3rem); align-self: start; }
  }
</style>
