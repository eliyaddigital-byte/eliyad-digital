---
/** סרטון היכרות / מכירה (מקום מדיה #2). מוצג רק כשיש קובץ, או בעמוד התצוגה. */
import MediaSlot from './MediaSlot.astro';
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
import { slot } from '../content/media';
interface Props { preview?: boolean }
const { preview = false } = Astro.props;
const show = Boolean(slot('vsl').file) || preview;
---
{show && (
  <section class="band band--fog vsl" id="video" aria-labelledby="vsl-title" data-section="video">
    <div class="wrap vsl__grid">
      <div class="vsl__copy">
        <h2 id="vsl-title" class="h-section">תכירו את מי שינהל לך את הקמפיינים</h2>
        <p class="lede">חצי דקה לפני שמדברים. אחרי הצפייה אפשר לשלוח הודעה ולקבוע שיחת אבחון.</p>
      </div>
      <MediaSlot id="vsl" preview={preview} class="vsl__media" alt="סרטון היכרות עם BoostRize" />
      {whatsappUrl && <a class="btn btn--black btn--lg vsl__cta" href={whatsappUrl} target="_blank" rel="noopener" data-cta="vsl-whatsapp"><Icon name="whatsapp" size={22} />שליחת הודעה בוואטסאפ</a>}
    </div>
  </section>
)}

<style>
  .vsl__grid { display: grid; gap: 1.75rem; grid-template-areas: 'copy' 'media' 'cta'; }
  .vsl__copy { grid-area: copy; display: grid; gap: 1.25rem; }
  .vsl__grid :global(.vsl__media) { grid-area: media; }
  .vsl__cta { grid-area: cta; width: 100%; }
  @media (min-width: 1024px) {
    .vsl__grid { grid-template-columns: 0.8fr 1.2fr; grid-template-areas: 'copy media' 'cta media'; column-gap: 4rem; row-gap: 1.75rem; align-content: center; }
    .vsl__copy { align-self: end; }
    .vsl__cta { align-self: start; justify-self: start; width: auto; }
  }
</style>
