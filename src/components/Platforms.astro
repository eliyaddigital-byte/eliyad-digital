---
import { platforms, platformsSection } from '../content/home';
const row = [...platforms, ...platforms];
---
<section class="platforms" aria-labelledby="platforms-title" data-section="platforms">
  <div class="container platforms__head">
    <h2 id="platforms-title" class="platforms__title">{platformsSection.title}</h2>
  </div>
  <div class="platforms__track-wrap">
    <ul class="platforms__track" role="list">
      {row.map((p, i) => (
        <li class={`platforms__item platforms__item--${p.group}`} aria-hidden={i >= platforms.length ? 'true' : undefined} dir="ltr">
          <span class="platforms__dot"></span>{p.name}
        </li>
      ))}
    </ul>
  </div>
  <p class="container platforms__note">{platformsSection.note}</p>
</section>

<style>
  .platforms { padding-block: 2.5rem 2rem; border-block: 2px solid var(--ink); background: var(--white); }
  .platforms__title { font-size: var(--fs-md); font-weight: 600; letter-spacing: 0; color: var(--ink-soft); margin-bottom: 1.25rem; text-align: center; }
  .platforms__track-wrap { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .platforms__track { display: flex; gap: 0.9rem; width: max-content; animation: marquee 48s linear infinite; padding-block: 4px; }
  .platforms__track-wrap:hover .platforms__track { animation-play-state: paused; }
  .platforms__item {
    display: inline-flex; align-items: center; gap: 0.6rem; white-space: nowrap;
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem); font-weight: 800; letter-spacing: -0.02em;
    padding: 0.5rem 1.25rem; border: 2px solid var(--ink); border-radius: var(--radius-pill); background: var(--paper);
  }
  .platforms__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--orange); }
  .platforms__item--data .platforms__dot { background: var(--ink); }
  .platforms__item--automation .platforms__dot { background: transparent; border: 2px solid var(--ink); }
  .platforms__note { margin-top: 1.1rem; text-align: center; font-size: var(--fs-xs); color: var(--ink-soft); }
  @keyframes marquee { to { transform: translateX(50%); } }
  @media (prefers-reduced-motion: reduce) {
    .platforms__track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding-inline: var(--gutter); }
    .platforms__item[aria-hidden='true'] { display: none; }
  }
</style>
