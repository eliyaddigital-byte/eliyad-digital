---
/**
 * VSL – סרטון מכירה/היכרות. מוצג רק כש-video.enabled=true ויש id אמיתי (src/content/home.ts).
 * YouTube/Vimeo נטענים רק אחרי לחיצה (lite-embed) – לא פוגע במהירות.
 */
import Icon from './Icon.astro';
import { video } from '../content/home';
import { withBase } from '../lib/text';
const show = video.enabled && Boolean(video.provider) && Boolean(video.id);
const poster = video.poster
  ? withBase(video.poster)
  : video.provider === 'youtube'
    ? `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`
    : '';
const embed =
  video.provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.id)}?autoplay=1&rel=0&enablejsapi=1`
    : video.provider === 'vimeo'
      ? `https://player.vimeo.com/video/${encodeURIComponent(video.id)}?autoplay=1&dnt=1`
      : '';
---
{show && (
  <section class="section vsl" id="video" aria-labelledby="video-title" data-section="video">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">{video.eyebrow}</p>
        <h2 id="video-title">{video.title}</h2>
      </div>
      <div class="vsl__frame" data-reveal data-vsl data-embed={embed} data-title={video.title}>
        {video.provider === 'file' ? (
          <video controls preload="none" playsinline poster={poster || undefined} data-vsl-file>
            <source src={withBase(video.id)} />
          </video>
        ) : (
          <button type="button" class="vsl__play" aria-label={`הפעלת הסרטון: ${video.title}`} data-vsl-play>
            {poster && <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />}
            <span class="vsl__btn"><Icon name="play" size={34} /></span>
          </button>
        )}
      </div>
    </div>
  </section>
)}

<script>
  const frame = document.querySelector<HTMLElement>('[data-vsl]');
  const track = (e: string, p: Record<string, unknown> = {}) => window.__brTrack?.(e, p);
  frame?.querySelector('[data-vsl-play]')?.addEventListener('click', () => {
    const src = frame.dataset.embed;
    if (!src) return;
    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = frame.dataset.title || 'וידאו';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    frame.replaceChildren(iframe);
    track('video_start', { video_title: frame.dataset.title, video_provider: src.includes('vimeo') ? 'vimeo' : 'youtube' });
  });
  const vid = frame?.querySelector<HTMLVideoElement>('[data-vsl-file]');
  if (vid) {
    let started = false;
    vid.addEventListener('play', () => { if (!started) { started = true; track('video_start', { video_title: frame?.dataset.title, video_provider: 'file' }); } });
    vid.addEventListener('ended', () => track('video_complete', { video_title: frame?.dataset.title, video_provider: 'file' }));
  }
</script>

<style>
  .vsl__frame { position: relative; max-width: 960px; margin-inline: auto; aspect-ratio: 16 / 9; background: var(--ink); border: 2px solid var(--ink); border-radius: var(--radius); overflow: hidden; box-shadow: 12px 12px 0 var(--orange); }
  .vsl__frame :global(iframe), .vsl__frame video { width: 100%; height: 100%; border: 0; }
  .vsl__play { position: absolute; inset: 0; border: 0; padding: 0; background: var(--ink); display: grid; place-items: center; }
  .vsl__play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.85; }
  .vsl__btn { position: relative; width: 92px; height: 92px; border-radius: 50%; background: var(--orange); color: var(--ink); display: grid; place-items: center; transition: transform var(--dur) var(--ease-out); box-shadow: 0 0 0 0 rgb(243 122 31 / 0.6); animation: ring 2.4s infinite; }
  .vsl__play:hover .vsl__btn { transform: scale(1.08); }
  .vsl__btn :global(svg) { fill: currentColor; margin-inline-end: -4px; }
  @keyframes ring { 70% { box-shadow: 0 0 0 22px rgb(243 122 31 / 0); } 100% { box-shadow: 0 0 0 0 rgb(243 122 31 / 0); } }
</style>
